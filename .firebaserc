{
  "projects": {
    "default": "jamui-services",
    "staging": "jamui-services-staging"
  },
  "targets": {
    "jamui-services": {
      "hosting": {
        "provider": [
          "jamui-provider"
        ],
        "main": [
          "jamui-services"
        ],
        "admin": [
          "jamui-admin"
        ]
      }
    },
    "jamui-services-staging": {
      "hosting": {
        "admin": [
          "jamui-services-staging-admin"
        ],
        "provider": [
          "jamui-services-staging-provider"
        ]
      }
    }
  },
  "etags": {}
}